# Portada corporativa RockyGuard — sirve la raiz exacta "/" desde /etc/bigbluebutton/branding/landing
# (directorio que los upgrades de BBB no tocan). Todas las demas rutas siguen yendo a Greenlight.
location = / {
    root /etc/bigbluebutton/branding/landing;
    try_files /index.html =404;
}
location = /rg-logo-light-bg.svg {
    root /etc/bigbluebutton/branding/landing;
}
location = /logo-rockyguard.svg {
    root /etc/bigbluebutton/branding/landing;
}
location = /rg-default.pdf {
    root /etc/bigbluebutton/branding/landing;
}
# BBB AI Notes: interruptor "Asistente de IA" en Settings de las salas (ver ai-notes/README.md)
location = /rg-ai-notes.js {
    root /etc/bigbluebutton/branding/landing;
    add_header Cache-Control "no-cache";
}

# Fix: la SPA de Greenlight navega a "/" con client-side routing (History API) al cerrar
# sesion, por lo que nunca llega a nginx y muestra su propio home hasta hacer refresh.
# Este script inyectado en el <head> de las paginas HTML convierte toda navegacion
# interna a "/" en una carga completa, que si pasa por nginx y sirve la portada.
sub_filter '</head>' '<script>(function(){function g(f){return function(s,t,u){if(u==="/"||u===location.origin+"/"){location.href="/";return}return f.call(history,s,t,u)}}history.pushState=g(history.pushState);history.replaceState=g(history.replaceState)})();</script><script src="/rg-ai-notes.js" defer></script></head>';
sub_filter_once on;
